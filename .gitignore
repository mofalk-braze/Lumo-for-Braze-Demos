*.tsbuildinfo

# iOS shell
ios-shell/DerivedData/
ios-shell/build/
# Generated by XcodeGen from project.yml — regenerate with `xcodegen generate`
ios-shell/*.xcodeproj/
ios-shell/*.xcworkspace/
*.xcuserstate
ios-shell/Sources/Config.swift

# macOS / editors
.DS_Store
*.swp
.idea/
.claude/

# ---------------------------------------------------------------------------
# Credentials / secrets — NEVER commit these.
# ---------------------------------------------------------------------------
# Apple APNs auth keys / push certs / provisioning
*.p8
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
# Local Braze SDK creds seed (use Config.example.swift as the committed template;
# real creds also live in the in-app Setup screen → UserDefaults, never in source)
ios-shell/Sources/Config.swift
# Env files
.env
.env.*
!.env.example

# Android shell
android-shell/.gradle/
android-shell/build/
android-shell/app/build/
android-shell/local.properties
android-shell/local.properties.backup.*
android-shell/app/src/**/google-services.json
android-shell/.active-demo-pack
.demo-launcher/
.demo-packs/
demo-packs/*/secrets.properties
web-template/src/brand/activeDemoConfig.generated.ts
web-template/public/demo-runtime.json
web-template/public/demo-assets/
android-shell/**/*.jks
android-shell/**/*.keystore
android-shell/**/firebase-service-account*.json
android-shell/**/service-account*.json
android-shell/**/braze-secrets*.json


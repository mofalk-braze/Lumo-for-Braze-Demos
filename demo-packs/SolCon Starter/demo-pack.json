{
  "id": "solcon-starter",
  "name": "SolCon Starter",
  "description": "Generic Lumo loyalty and offers app for validating Content Card placements in the shared SolCon demo shell.",
  "android": {
    "defaultExternalId": "solcon-demo-user",
    "defaultProfileName": "Lumo Playground"
  },
  "launcher": {
    "presets": [
      {
        "id": "solcon_sdk_onboarding_step",
        "label": "Complete onboarding",
        "description": "Logs onboarding_completed through the active native SDK.",
        "type": "sdk_event",
        "payload": {
          "name": "onboarding_completed",
          "properties": {
            "source": "control_room",
            "plan": "playground"
          }
        }
      },
      {
        "id": "solcon_sdk_set_interest",
        "label": "Set demo interest",
        "description": "Sets demo_interest=mobile_channels on the active SDK user.",
        "type": "sdk_attribute",
        "payload": {
          "key": "demo_interest",
          "value": "mobile_channels"
        }
      },
      {
        "id": "solcon_sdk_purchase",
        "label": "Log sample activation",
        "description": "Logs a non-customer sample purchase through the active native SDK.",
        "type": "sdk_purchase",
        "payload": {
          "productId": "lumo_activation",
          "price": 29,
          "currency": "EUR",
          "quantity": 1,
          "properties": {
            "source": "control_room",
            "category": "demo"
          }
        }
      },
      {
        "id": "library_trigger_content_card",
        "label": "Trigger Content Card",
        "description": "Template for an API-triggered campaign send.",
        "type": "campaign_trigger",
        "payload": {
          "campaignId": "857ea04d-b7db-4493-8e06-c39934bd3993",
          "triggerProperties": {
            "source": "control_room"
          }
        },
        "transport": "braze_rest",
        "platform": "host",
        "requiresPushToken": false,
        "custom": false
      }
    ]
  },
  "brand": {
    "appName": "Lumo",
    "displayName": "Lumo Playground",
    "tagline": "Deals, rewards, and updates in one place.",
    "logoText": "LP",
    "colors": {
      "brand": "#801ED7",
      "brandDark": "#300266",
      "brandLight": "#F4EAFE",
      "accent": "#FFA524",
      "ink": "#17131F",
      "muted": "#686176",
      "line": "#E4DDED",
      "surface": "#FBF9FF"
    },
    "tabs": [
      { "id": "home", "label": "Home", "icon": "Home" },
      { "id": "inbox", "label": "Inbox", "icon": "Inbox" },
      { "id": "account", "label": "Account", "icon": "User" }
    ],
    "flavorEvents": [
      {
        "name": "onboarding_completed",
        "label": "Onboarding completed",
        "anchor": "preference_updated",
        "emitAnchor": true,
        "sample": {
          "plan": "playground",
          "source": "app"
        }
      },
      {
        "name": "feature_explored",
        "label": "Feature explored",
        "anchor": "content_engaged",
        "emitAnchor": true,
        "sample": {
          "feature": "message_center",
          "source": "app"
        }
      },
      {
        "name": "offer_saved",
        "label": "Offer saved",
        "anchor": "offer_interaction",
        "emitAnchor": true,
        "sample": {
          "offer": "starter_bundle",
          "source": "app"
        }
      }
    ],
    "demoUser": {
      "externalId": "solcon-demo-user",
      "firstName": "SolCon",
      "attributes": {
        "demo_interest": "mobile_channels",
        "lifecycle_stage": "starter",
        "home_location": "Berlin",
        "favorite_categories": [
          "messaging",
          "loyalty"
        ],
        "last_conversion_value": 29
      }
    }
  },
  "content": {
    "hero": {
      "title": "Your weekly rewards are ready",
      "subtitle": "Fresh offers, member perks, and hand-picked updates for your next order.",
      "cta": "Browse offers"
    },
    "categories": [
      "For you",
      "New",
      "Offers",
      "Loyalty",
      "Essentials",
      "Nearby"
    ],
    "contentCardRail": {
      "title": "For you",
      "placement": "home"
    },
    "contentCardSurfaces": [
      {
        "id": "lumo-hero",
        "placement": "hero",
        "surface": "hero",
        "screen": "home",
        "title": "Featured for you",
        "variant": "hero",
        "emptyBehavior": "hide",
        "maxCards": 1
      },
      {
        "id": "home-feed",
        "placement": "home",
        "surface": "carousel",
        "screen": "home",
        "title": "For you",
        "variant": "carousel",
        "emptyBehavior": "hide",
        "maxCards": 4
      },
      {
        "id": "lumo-inline",
        "placement": "inline",
        "surface": "feed",
        "screen": "home",
        "title": "Recommended today",
        "variant": "feed",
        "emptyBehavior": "hide",
        "maxCards": 2
      },
      {
        "id": "starter-inbox",
        "placement": "inbox",
        "surface": "inbox",
        "screen": "inbox",
        "title": "Inbox",
        "variant": "inbox",
        "emptyBehavior": "empty-state",
        "maxCards": 8
      },
      {
        "id": "lumo-account-panel",
        "placement": "account",
        "surface": "account",
        "screen": "account",
        "title": "Member updates",
        "variant": "feed",
        "emptyBehavior": "hide",
        "maxCards": 2
      }
    ],
    "placementPlayground": {
      "toggles": {
        "hero": true,
        "homeFeed": true,
        "inlineModule": true,
        "inboxTab": true,
        "accountPanel": true,
        "compactCards": false
      }
    },
    "rails": [
      {
        "id": "starter-actions",
        "title": "Popular picks",
        "items": [
          {
            "id": "pick_market",
            "title": "Market basket",
            "subtitle": "Weekly essentials",
            "meta": "EUR 29",
            "badge": "Popular",
            "category": "essentials"
          },
          {
            "id": "pick_audio",
            "title": "Wireless earbuds",
            "subtitle": "Member price",
            "meta": "EUR 49",
            "category": "new"
          },
          {
            "id": "pick_coffee",
            "title": "Coffee subscription",
            "subtitle": "Roasted nearby",
            "meta": "EUR 12",
            "category": "nearby"
          },
          {
            "id": "pick_home",
            "title": "Home refresh",
            "subtitle": "Limited bundle",
            "meta": "EUR 34",
            "category": "offers"
          }
        ]
      },
      {
        "id": "starter-offers",
        "title": "Member perks",
        "items": [
          {
            "id": "offer_bundle",
            "title": "Starter bundle",
            "subtitle": "Member-only set",
            "meta": "EUR 29",
            "badge": "Deal",
            "category": "offers"
          },
          {
            "id": "offer_loyalty",
            "title": "Loyalty boost",
            "subtitle": "Next-tier progress",
            "meta": "+250 points",
            "category": "loyalty"
          },
          {
            "id": "offer_channel",
            "title": "Free delivery",
            "subtitle": "This weekend",
            "meta": "2 days",
            "category": "offers"
          },
          {
            "id": "offer_inbox",
            "title": "Message center",
            "subtitle": "Saved updates",
            "meta": "Inbox",
            "category": "inbox"
          }
        ]
      }
    ]
  }
}

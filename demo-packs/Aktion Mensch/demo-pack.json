{
  "id": "aktion-mensch",
  "name": "Aktion Mensch",
  "description": "Aktion Mensch lottery app demo for ticket management, draw checks, preferences, Content Cards, in-app messages, and push.",
  "android": {
    "defaultExternalId": "aktion-mensch-demo-user",
    "defaultProfileName": "Aktion Mensch"
  },
  "launcher": {
    "presets": [
      {
        "id": "aktion_los_added",
        "label": "Add Glücks-Los",
        "description": "Logs a ticket add event through the mobile SDK.",
        "type": "sdk_event",
        "payload": {
          "name": "aktion_los_added",
          "properties": {
            "product": "Glücks-Los",
            "surface": "lose",
            "method": "manual",
            "source": "control_room"
          }
        }
      },
      {
        "id": "aktion_draw_checked",
        "label": "Check draw",
        "description": "Logs a draw check event through the mobile SDK.",
        "type": "sdk_event",
        "payload": {
          "name": "aktion_draw_checked",
          "properties": {
            "draw_date": "2026-06-21",
            "surface": "pruefen",
            "has_saved_ticket": true,
            "source": "control_room"
          }
        }
      },
      {
        "id": "aktion_extra_chance",
        "label": "Start Extra-Chance",
        "description": "Logs an offer interaction for the summer special Extra-Chance.",
        "type": "sdk_event",
        "payload": {
          "name": "offer_interaction",
          "properties": {
            "offer_id": "extra_chance_2026",
            "offer_name": "Die Hauptpreise kommen bald",
            "surface": "home",
            "action": "started",
            "source": "control_room"
          }
        }
      },
      {
        "id": "aktion_enable_notifications",
        "label": "Enable notifications",
        "description": "Sets notification preference and logs preference_updated.",
        "type": "android_sequence",
        "payload": {
          "commands": [
            {
              "action": "setCustomAttribute",
              "payload": {
                "attributes": {
                  "notifications_enabled": true,
                  "direct_result": false
                }
              }
            },
            {
              "action": "logCustomEvent",
              "payload": {
                "name": "preference_updated",
                "properties": {
                  "preference": "notifications_enabled",
                  "value": true,
                  "surface": "settings",
                  "source": "control_room"
                }
              }
            }
          ]
        }
      },
      {
        "id": "aktion_push_draw_ready",
        "label": "Show draw push",
        "description": "Shows a foreground push-style draw reminder in the native shell.",
        "type": "foreground_push",
        "payload": {
          "title": "Deine Ziehung ist bereit",
          "body": "Prüfe jetzt, ob dein Glücks-Los gewonnen hat.",
          "uri": "/pruefen"
        }
      }
    ]
  },
  "brand": {
    "appName": "Aktion Mensch",
    "displayName": "Aktion Mensch",
    "tagline": "Dein Ticket zum Glück immer dabei.",
    "logoText": "AM",
    "colors": {
      "brand": "#ED1019",
      "brandDark": "#B20811",
      "brandLight": "#FFE4E6",
      "accent": "#159B83",
      "ink": "#282828",
      "muted": "#737373",
      "line": "#D9D9D9",
      "surface": "#F1F1F1"
    },
    "tabs": [
      {
        "id": "start",
        "label": "Start",
        "icon": "Home"
      },
      {
        "id": "lose",
        "label": "Lose",
        "icon": "Ticket"
      },
      {
        "id": "pruefen",
        "label": "Prüfen",
        "icon": "Clover"
      },
      {
        "id": "mehr",
        "label": "Mehr",
        "icon": "Menu"
      }
    ],
    "flavorEvents": [
      {
        "name": "aktion_los_added",
        "label": "Ticket added",
        "anchor": "content_engaged",
        "emitAnchor": true,
        "sample": {
          "product": "Glücks-Los",
          "surface": "lose",
          "method": "manual"
        }
      },
      {
        "name": "aktion_account_linked",
        "label": "Account linked",
        "anchor": "loyalty_event",
        "emitAnchor": true,
        "sample": {
          "surface": "lose",
          "action": "linked"
        }
      },
      {
        "name": "aktion_draw_checked",
        "label": "Draw checked",
        "anchor": "content_viewed",
        "emitAnchor": true,
        "sample": {
          "draw_date": "2026-06-21",
          "surface": "pruefen",
          "has_saved_ticket": true
        }
      },
      {
        "name": "aktion_extra_chance_started",
        "label": "Extra-Chance started",
        "anchor": "offer_interaction",
        "emitAnchor": true,
        "sample": {
          "offer_id": "extra_chance_2026",
          "surface": "home",
          "action": "started"
        }
      },
      {
        "name": "aktion_help_opened",
        "label": "Help opened",
        "anchor": "content_viewed",
        "sample": {
          "topic": "lose",
          "surface": "mehr"
        }
      }
    ],
    "demoUser": {
      "externalId": "aktion-mensch-demo-user",
      "firstName": "Mo",
      "attributes": {
        "active_lots": 2,
        "lottery_customer": true,
        "favorite_product": "Glücks-Los",
        "notifications_enabled": false,
        "direct_result": false,
        "lifecycle_stage": "ticket_manager"
      }
    }
  },
  "content": {
    "hero": {
      "title": "Die Hauptpreise kommen bald!",
      "subtitle": "Jetzt noch Extra-Chance sichern.",
      "cta": "Jetzt Extra-Chance ergreifen"
